# Absolute Mind CRM — environment variables
# Copy to .env.local for local development.


# When unset, the app runs in Demo Mode with sample data (no Supabase required).
DEMO_MODE=true


# Supabase (required for production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# App URL (used in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# Email via Resend.
# Each valid website enquiry sends two independent, best-effort emails:
#   1. an acknowledgement to the enquirer (skipped for Do Not Contact / no email)
#   2. a notification to Paula at PAULA_NOTIFY_EMAIL
# Both outcomes are logged separately on the contact timeline (sent/skipped/failed).
# When RESEND_API_KEY is empty both are skipped and the enquiry is still saved.
RESEND_API_KEY=
EMAIL_FROM=Absolute Mind <paula@absolutemind.co.uk>
PAULA_NOTIFY_EMAIL=paula@paulasweet.co.uk


# Cloudflare Turnstile (spam protection on /enquiry and /embed/enquiry)
# Leave both empty for demo/local: no widget is shown and the API skips the check.
# Set BOTH in production. The widget's Cloudflare hostname list must include
# crm.absolutemind.co.uk (the iframe's own host) — not the WordPress domain.
# Cloudflare test keys for local dev (always pass):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# Sites allowed to iframe the embeddable form (/embed/*), comma or space separated.
# Read at build time — change it on Vercel and redeploy. The deployment's own
# origin ('self') is always allowed. Default when unset:
#   https://absolutemind.co.uk https://www.absolutemind.co.uk
#   https://paulasweet.co.uk https://www.paulasweet.co.uk
#   https://crm.absolutemind.co.uk http://localhost:3000
# EMBED_FRAME_ANCESTORS=https://absolutemind.co.uk,https://www.absolutemind.co.uk


# Google Calendar (shared with booking app — future wiring)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=


# Shared secret for the self-hosted Checkapp assessment integration.
# Set the same random value in Checkapp as CRM_WEBHOOK_SECRET.
CHECKAPP_WEBHOOK_SECRET=
