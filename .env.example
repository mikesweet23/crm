# Absolute Mind CRM — environment variables
# Copy to .env.local for local development.

# When unset, the app runs in Demo Mode with sample data (no Supabase required).
DEMO_MODE=true

# Supabase (required for production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=Absolute Mind <paula@absolutemind.co.uk>
PAULA_NOTIFY_EMAIL=paula@paulasweet.co.uk

# Cloudflare Turnstile (public enquiry form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Calendar (shared with booking app — future wiring)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=
